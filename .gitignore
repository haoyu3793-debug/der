# Phoenix Park Deer Tracker

# Test harnesses. These are copies of index.html with a test script injected.
# They must never reach the deployed site: they are full working pages, so a
# stray link to one would serve a version of the homepage that wipes storage.
_*.html
_*.js

# Local database, if the Lesson 15 backend is ever run from this folder
*.db
*.db-journal
*.sqlite

# Editor and OS noise
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# Tunnel and server bookkeeping
*.pid
*.log

# Wrangler's local cache. Holds your Cloudflare account id; not secret, but it
# is machine-local bookkeeping and does not belong in the repository.
.wrangler/
